{
  "_doc": "total_king 라우팅 규칙. 입력 메타(mod · 자료 유형 · 신호)로 어떤 자(스킬)를 댈지 고른다. 점수는 건드리지 않는다. 규칙은 결정적 — 같은 메타면 같은 배치.",
  "version": "1.4.0",
  "always_first": ["slda-core"],
  "context": {
    "case_index": "slda-case-index",
    "counterpart_ledger": {"skill": "slda-counterpart-ledger", "when": "pair_id != null"}
  },
  "preprocess": [
    {"skill": "slda-transcript", "when": "sources contains call|audio|stt"}
  ],
  "modules": {
    "litigation": {
      "skill": "slda-litigation",
      "match": {"mod": "litigation", "sources_any": ["서면", "소장", "준비서면", "답변서", "brief"]},
      "verdict_mode": "determine",
      "sub": [
        {"skill": "slda-inquiry", "when": "sources contains 신청서|제출명령|사실조회|과세정보|금융거래"}
      ]
    },
    "controversy": {"skill": "slda-controversy", "match": {"mod": "controversy"}, "verdict_mode": "rank"},
    "dispute":     {"skill": "slda-dispute",     "match": {"mod": "dispute"},     "verdict_mode": "determine"},
    "inquiry":     {"skill": "slda-inquiry",     "match": {"mod": "inquiry"},     "verdict_mode": "determine"}
  },
  "overlays": [
    {"skill": "slda-ai-invocation",  "when": "signals contains ai_mention", "modules": ["controversy", "dispute"]},
    {"skill": "slda-stylistic-drift", "when": "flags contains style", "verdict_mode_force": "observe"}
  ],
  "render": {"skill": "slda-report-html", "when": "output == html|pdf"},
  "human_cbt": "CBT 구간(20건)에서는 설계자가 이 배치를 확인·수정할 수 있다. 수정은 배치(어떤 자)만, 값(채점)은 불가."
}
